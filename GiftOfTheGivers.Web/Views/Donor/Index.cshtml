@model List<GiftOfTheGivers.Web.Models.Donation>
@using GiftOfTheGivers.Web.Models
@{
    ViewData["Title"] = "Donor Portal";
    var totalDonated = (decimal)ViewData["TotalDonated"]!;
    var projects = ViewData["ActiveProjects"] as List<ReliefProject> ?? new();
}

<div class="dashboard-wrap">
    <span class="dashboard-eyebrow">DONOR PORTAL</span>
    <h2 style="margin-top:6px;">Welcome, @User.Identity!.Name</h2>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-value">R @totalDonated.ToString("N0")</div>
            <div class="stat-label">Total Donated</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@ViewData["DonationsMade"]</div>
            <div class="stat-label">Donations Made</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@ViewData["Certificates"]</div>
            <div class="stat-label">Available Tax Certificates</div>
        </div>
    </div>

    <div class="form-card" style="text-align:center;">
        @if (!Model.Any())
        {
            <p style="font-size:1.5rem;margin:0;">🪙</p>
            <p style="color:var(--muted);">You haven't made a donation yet.</p>
            <a class="btn btn-green" asp-controller="Donation" asp-action="Donate">Make a Donation</a>
        }
        else
        {
            <table class="simple-table">
                <thead><tr><th>Date</th><th>Amount</th><th>Type</th><th>Certificate</th></tr></thead>
                <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.DonatedAt.ToString("yyyy-MM-dd")</td>
                        <td>@d.Currency @d.Amount.ToString("N2")</td>
                        <td>@d.DonationType</td>
                        <td>@d.CertificateNumber</td>
                    </tr>
                }
                </tbody>
            </table>
            <a class="btn btn-green" style="margin-top:16px;" asp-controller="Donation" asp-action="Donate">Make Another Donation</a>
        }
    </div>

    <h3 style="margin-top:32px;">Active Projects to Support</h3>
    <div class="form-card">
        @if (!projects.Any())
        {
            <div class="empty-state">No active projects right now.</div>
        }
        else
        {
            @foreach (var p in projects)
            {
                <div class="update-item">@p.Name</div>
            }
        }
    </div>
</div>
