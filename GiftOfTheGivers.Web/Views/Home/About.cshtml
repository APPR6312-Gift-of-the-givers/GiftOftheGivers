@{
    ViewData["Title"] = "About";
}
<section class="about-section">
    <div class="about-intro-content">
        <h2 class="about-section-title">About This Prototype</h2>
        <p class="about-section-sub">Built for APPR6312 POE Part 1 — a proof-of-concept, not the final system.</p>
        <div class="form-card" style="max-width:800px;margin:0 auto;">
            <p>The Gift of the Givers Foundation is the largest disaster response non-governmental organisation of African origin on the continent. 
                This site is a Version 1 prototype built with ASP.NET Core to prove out the core ideas: volunteer registration, donations, 
                employee updates, and secure role-based login — before the full system is built.
            </p>

            <p>Data for this prototype is stored in-memory (as permitted by the POE brief), so it resets each time the application restarts. 
                In a production system this would move to Azure SQL Database, hosted on Azure App Services.
            </p>
        </div>
    </div>

    <div class="about-image">
        <img src="~/images/about_image.jpg" asp-append-version="true" alt="Gift of the Givers team assisting a mom"/>
    </div>

</section>

<!-- ABOUT the gift of the givers -->
<section class="about-highlights">

    <div class="about-highlight-card">

        <div class="highlight-icon">
            🌍
        </div>

        <h3>Global Reach</h3>

        <p>
            Active operations in 60+ different countries across Africa, the Middle East, Asia, and Europe.
        </p>

    </div>

    <div class="about-highlight-card">

        <div class="highlight-icon">
            ⚡
        </div>

        <h3>Rapid Response</h3>

        <p>
            Within 24-72 hours of a disaster, our teams are mobilised with supplies and medical personnel.
        </p>
    </div>

    <div class="about-highlight-card">

        <div class="highlight-icon">
            🔍
        </div>

        <h3>Transparency</h3>

        <p>
            Every donation is accounted for. We publish annual reports and welcome third party audits.
        </p>

    </div>

</section>

